# Copy to .env.local for local builds, or add as GitHub Actions Repository Secrets
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKey
VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_DATABASE_URL=https://your-gcp-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=your-gcp-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Identity Platform OpenID Connect provider ID for Discord (default: oidc.discord)
VITE_DISCORD_OIDC_PROVIDER_ID=oidc.discord
